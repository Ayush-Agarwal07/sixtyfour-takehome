# --- LLM (only runtime LLM budget: $100 OpenRouter key) ---
OPENROUTER_API_KEY=

# --- search / fetch tools ---
SERPER_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
GITHUB_PAT=

# --- API server ---
# PI_API_KEY: if set, POST/GET require a matching X-API-Key header
PI_API_KEY=
# MAX_INFLIGHT: running + queued jobs before 429 (running cap is 3)
MAX_INFLIGHT=10
DAILY_JOB_CAP=200

# --- run switches (keep values bare: python-dotenv reads "0  # note" as "0  # note") ---
# PI_NO_CACHE=1 disables the http+llm cache (honest variance runs)
PI_NO_CACHE=0
# PI_OFFLINE=1 makes a cache miss raise (replay mode)
PI_OFFLINE=0
