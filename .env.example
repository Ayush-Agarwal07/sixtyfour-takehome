# --- LLM (only runtime LLM budget: $100 OpenRouter key) ---
OPENROUTER_API_KEY=

# --- search / fetch tools ---
SERPER_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
GITHUB_PAT=

# --- API server ---
PI_API_KEY=                 # if set, POST/GET require X-API-Key
MAX_INFLIGHT=10             # running + queued jobs before 429 (running cap is 3)
DAILY_JOB_CAP=200

# --- run switches ---
PI_NO_CACHE=0               # 1 disables http+llm cache (honest variance runs)
PI_OFFLINE=0               # 1 makes cache misses raise (replay mode)
